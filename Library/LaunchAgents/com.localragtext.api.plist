<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.localragtext.api</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/username/projects/local-llm-rag-qdrant-macos/run_api_server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/username/projects/local-llm-rag-qdrant-macos</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <!-- 127.0.0.1 = this Mac only. Use 0.0.0.0 to open the chat UI from
           other devices on your LAN (it has no authentication). -->
      <key>HOST</key>
      <string>127.0.0.1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>
  </dict>
</plist>
