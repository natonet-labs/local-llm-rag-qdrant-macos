<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.localragtext.qdrant</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/nvo/projects/local-llm-rag-qdrant-macos/qdrant.sh</string>
      <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nvo/projects/local-llm-rag-qdrant-macos</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nvo/.cargo/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- qdrant.sh starts Qdrant in the background and exits; keep launchd from killing it -->
    <key>AbandonProcessGroup</key>
    <true/>
  </dict>
</plist>
